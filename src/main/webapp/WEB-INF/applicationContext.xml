<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
         http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
         http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd
         http://www.springframework.org/schema/mvc
           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

  <!-- MVC infra beans are configured in the DispatcherServlet context (spring-servlet.xml). -->
  <!-- Avoid registering MVC/default servlet handler in the root context to prevent path conflicts. -->
  <!-- <mvc:annotation-driven/> -->
  <!-- <mvc:default-servlet-handler/> -->

    <import resource="classpath:spring/oauth-AS-config.xml"/>
    <import resource="classpath:spring/oauth-RS-config.xml"/>
    <import resource="classpath:spring/business-config.xml"/>
    <import resource="classpath:spring/data-config.xml"/>

  <!-- Controllers are scanned in the DispatcherServlet context (spring-servlet.xml) -->
  <!-- Removed scanning here to avoid duplicate/competing handler mappings in root context -->
    <context:component-scan base-package="org.greenbuttonalliance.espi.common.repositories"/>
    <context:component-scan base-package="org.greenbuttonalliance.espi.common.service"/>
    <context:component-scan base-package="org.greenbuttonalliance.espi.datacustodian.utils"/>
    <context:component-scan base-package="org.greenbuttonalliance.espi.datacustodian.oauth"/>

    <!-- ADDED: pick up the implementation of StateService -->
    <context:component-scan base-package="org.greenbuttonalliance.espi.common.service.impl"/>

    <!-- ADDED: explicit bean definition in case component-scan doesn't pick it up -->
    <bean id="stateService"
          class="org.greenbuttonalliance.espi.common.service.impl.StateServiceImpl"
          autowire-candidate="true"/>

    <bean id="viewResolver" class="org.springframework.web.servlet.view.ContentNegotiatingViewResolver">
        <property name="viewResolvers">
            <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
                <property name="prefix" value="/WEB-INF/jsp/"/>
                <property name="suffix" value=".jsp"/>
            </bean>
        </property>
        <property name="defaultViews">
            <!-- TODO: Migrate to MappingJackson2JsonView -->
            <bean class="org.springframework.web.servlet.view.json.MappingJackson2JsonView">
                <property name="extractValueFromSingleKeyModel" value="true"/>
            </bean>
        </property>
    </bean>

    <bean id="multipartResolver" class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
        <property name="maxUploadSize" value="10000000000"/>
    </bean>

    <bean id="restTemplate" class="org.springframework.web.client.RestTemplate"/>
</beans>
