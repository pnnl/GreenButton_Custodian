<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:sec="http://www.springframework.org/schema/security"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-4.3.xsd
           http://www.springframework.org/schema/security
           http://www.springframework.org/schema/security/spring-security-4.2.xsd">
    <bean id="savedRequestSuccessHandler"
        class="org.springframework.security.web.authentication.SavedRequestAwareAuthenticationSuccessHandler"/>



    <!-- Batch/RetailCustomer APIs (specific rule first) -->
    <http pattern="/espi/1_1/resource/Batch/RetailCustomer/**"
          create-session="never"
          entry-point-ref="oauthAuthenticationEntryPoint"
          use-expressions="false"
          access-decision-manager-ref="accessDecisionManager"
          xmlns="http://www.springframework.org/schema/security">
        <csrf disabled="true"/>
        <anonymous enabled="false"/>
        <intercept-url pattern="/espi/1_1/resource/Batch/RetailCustomer/**"
                       access="ROLE_USER"/>
        <custom-filter ref="resourceServerFilter" before="PRE_AUTH_FILTER"/>
        <access-denied-handler ref="oauthAccessDeniedHandler"/>
    </http>

    <!-- General ESPI resource endpoints -->
    <http pattern="/espi/1_1/resource/**"
          create-session="never"
          entry-point-ref="oauthAuthenticationEntryPoint"
          use-expressions="false"
          access-decision-manager-ref="accessDecisionManager"
          xmlns="http://www.springframework.org/schema/security">
        <csrf disabled="true"/>
        <anonymous enabled="false"/>
        <!-- only fully authenticated requests allowed -->
        <intercept-url pattern="/espi/1_1/resource/**"
                       access="IS_AUTHENTICATED_FULLY"/>
        <custom-filter ref="resourceServerFilter" before="PRE_AUTH_FILTER"/>
        <access-denied-handler ref="oauthAccessDeniedHandler"/>
    </http>

    <!-- Management requests -->
    <http pattern="/management/**"
          create-session="never"
          entry-point-ref="oauthAuthenticationEntryPoint"
          use-expressions="false"
          access-decision-manager-ref="accessDecisionManager"
          xmlns="http://www.springframework.org/schema/security">
        <anonymous enabled="false"/>
        <intercept-url pattern="/management/**"/>
        <custom-filter ref="resourceServerFilter" before="PRE_AUTH_FILTER"/>
        <access-denied-handler ref="oauthAccessDeniedHandler"/>
    </http>

        <!-- Public data import API: completely bypass Spring Security -->
        <http pattern="/api/data/**" security="none" xmlns="http://www.springframework.org/schema/security"/>

    <!-- Custodian portal -->
     <http pattern="/custodian/**"
          create-session="always"
          use-expressions="false"
          authentication-manager-ref="authenticationManager"
          xmlns="http://www.springframework.org/schema/security">

        <!-- disable CSRF for everything under /custodian -->
        <csrf disabled="true"/>

        <!-- allow anonymous POST to the upload URL -->
        <intercept-url 
            pattern="/custodian/retailcustomers/*/upload" 
            access="IS_AUTHENTICATED_ANONYMOUSLY"/>

        <!-- all other custodian URLs still require ROLE_CUSTODIAN -->
        <intercept-url 
            pattern="/custodian/**" 
            access="ROLE_CUSTODIAN"/>

        <access-denied-handler error-page="/WEB-INF/jsp/403.jsp"/>

        <form-login
            authentication-failure-url="/login?authentication_error=true"
            default-target-url="/default"
            login-page="/login"/>

        <logout logout-success-url="/" logout-url="/logout.do"/>
    </http>

    <!-- Customer portal -->
    <http pattern="/customer/**"
          create-session="always"
          use-expressions="false"
          authentication-manager-ref="authenticationManager"
          xmlns="http://www.springframework.org/schema/security">
        <intercept-url pattern="/customer/**" access="ROLE_USER"/>
        <access-denied-handler error-page="/WEB-INF/jsp/403.jsp"/>
        <form-login
            authentication-failure-url="/login?authentication_error=true"
            default-target-url="/default"
            login-page="/login"/>
        <logout logout-success-url="/" logout-url="/logout.do"/>
    </http>
    
    <!-- Fallback / OAuth login -->
    <sec:http pattern="/**"
            disable-url-rewriting="true" authentication-manager-ref="authenticationManager"
            use-expressions="false">
    <sec:anonymous/>
    <sec:intercept-url pattern="/**" access="IS_AUTHENTICATED_ANONYMOUSLY"/>
    <sec:form-login login-page="/login"
                    authentication-failure-url="/login?authentication_error=true"
                    default-target-url="/default"/>
    <sec:logout logout-success-url="/" logout-url="/logout.do"/>
    <sec:access-denied-handler error-page="/login?authorization_error=true"/>
  </sec:http>


</beans>
